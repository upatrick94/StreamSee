PORT=8080
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.vercel.app,https://*.vercel.app

# Demo-friendly default persistence on Railway:
# 1. Attach a Railway volume mounted to /app/data
# 2. Keep the default H2 file database below
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/mpp-playlists;MODE=PostgreSQL;AUTO_SERVER=TRUE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Required if you want chat persistence across restarts
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/mpp_chat

# Mail delivery:
# - log: writes codes to Railway logs
# - smtp: sends real emails using the SMTP vars below
APP_MAIL_DELIVERY_MODE=log
APP_MAIL_FROM=no-reply@example.com

# Only needed when APP_MAIL_DELIVERY_MODE=smtp
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional
APP_SEED_DEMO_DATA=true
APP_SESSION_TIMEOUT_SECONDS=900
